table 'Medidas DAX'
	lineageTag: 745007f7-89c3-4d40-a97a-375645f82d02

	measure 'Total Medicamentos' =
			
			DISTINCTCOUNT(dim_medicamento[id_medicamento])
		formatString: 0
		lineageTag: e55fd03c-4585-4430-bf3d-229d5d83ee4b

	measure 'Stock Total' =
			
			SUM(medicamentos_multifuente[stock])
		formatString: 0
		lineageTag: 9a30cc9e-1519-4de6-b893-3321fc327b12

	measure 'Stock Promedio' =
			
			AVERAGE(medicamentos_multifuente[stock])
		lineageTag: 8dba33e8-11f8-40e0-97b6-b82d8e1fc9c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Medicamentos Stock Bajo' =
			
			CALCULATE(
			    DISTINCTCOUNT(medicamentos_multifuente[id_medicamento]),
			    medicamentos_multifuente[stock] < 200
			)
		formatString: 0
		lineageTag: adca9d63-b71b-4cb3-bb2a-7a60a6901e6f

	measure 'Total Ensayos' =
			
			SUM(resumen_ensayos_medicamentos[total_ensayos])
		formatString: 0
		lineageTag: 20dbf4c8-e6ef-473f-b070-2e0cc6c6b694

	measure 'Total Prescripciones' =
			
			COUNTROWS(fact_prescripciones)
		formatString: 0
		lineageTag: ae6a5d14-02ef-47af-a9af-6cd8a2feced0

	measure 'Total Medicamentos Recetados' =
			
			COUNTROWS(medicamentos_recetados)
		formatString: 0
		lineageTag: 366fd7fe-cf07-431b-9d2d-613ff1032510

	measure 'Promedio Medicamentos por Prescripción' =
			
			DIVIDE(
			    [Total Medicamentos Recetados],
			    [Total Prescripciones],
			    0
			)
		lineageTag: 262ae322-cd8b-4b58-9fb6-a5185f836fde

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio de dia entre reingresos' = ```
			AVERAGE(reingresos_30_dias[dias_entre_ingresos]
			)
			
			```
		lineageTag: 290b4e27-83ee-4349-a160-bb119a324a72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total reingresos' = ```
			AVERAGE(reingresos_30_dias[dias_entre_ingresos]
			)
			
			```
		lineageTag: c7faec71-a680-4d6c-98c1-3f36279c1ebd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Pacientes con reingresos' = ```
			DIVIDE(   DISTINCTCOUNT(reingresos_30_dias[id_paciente]),
			CALCULATE(       DISTINCTCOUNT(reingresos_30_dias[id_paciente]),      REMOVEFILTERS(reingresos_30_dias)
			    ),
			    0
			)
			
			```
		lineageTag: 1c0e70f0-1c02-4cc6-b5bb-08902cd9b065

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reingresos Menos de 15 Días' =
			
			CALCULATE(
			    [Total Reingresos],
			    reingresos_30_dias[dias_entre_ingresos] < 15
			)
		lineageTag: 6bdedecf-a22b-427e-bf6f-6c3ea7903bc9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Reingresos Entre 15 y 30 Días' =
			
			CALCULATE(
			    [Total Reingresos],
			    reingresos_30_dias[dias_entre_ingresos] >= 15,
			    reingresos_30_dias[dias_entre_ingresos] <= 30
			)
		lineageTag: 9da72c37-f68c-41a4-8d7d-a4cb81f45fcb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 98eb1f7d-24ff-4348-b4ca-851b4c5bc55a
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition 'Medidas DAX' = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 682138c3f65144d383deb188d8aceaca

