table 'Medidas DAX'
	lineageTag: 745007f7-89c3-4d40-a97a-375645f82d02

	measure 'Total Medicamentos' =
			
			DISTINCTCOUNT(dim_medicamento[id_medicamento])
		formatString: 0
		lineageTag: e55fd03c-4585-4430-bf3d-229d5d83ee4b

	measure 'Stock Total' =
			
			SUM(medicamentos_multifuente[stock])
		formatString: 0
		lineageTag: 9a30cc9e-1519-4de6-b893-3321fc327b12

	measure 'Stock Promedio' =
			
			AVERAGE(medicamentos_multifuente[stock])
		lineageTag: 8dba33e8-11f8-40e0-97b6-b82d8e1fc9c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Medicamentos Stock Bajo' =
			
			CALCULATE(
			    DISTINCTCOUNT(medicamentos_multifuente[id_medicamento]),
			    medicamentos_multifuente[stock] < 200
			)
		formatString: 0
		lineageTag: adca9d63-b71b-4cb3-bb2a-7a60a6901e6f

	measure 'Total Ensayos' =
			
			SUM(resumen_ensayos_medicamentos[total_ensayos])
		formatString: 0
		lineageTag: 20dbf4c8-e6ef-473f-b070-2e0cc6c6b694



		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 98eb1f7d-24ff-4348-b4ca-851b4c5bc55a
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition 'Medidas DAX' = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 682138c3f65144d383deb188d8aceaca

