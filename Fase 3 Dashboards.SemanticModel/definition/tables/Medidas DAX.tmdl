table 'Medidas DAX'
	lineageTag: 745007f7-89c3-4d40-a97a-375645f82d02

	measure 'Total Medicamentos' =
			
			DISTINCTCOUNT(dim_medicamento[id_medicamento])
		formatString: 0
		lineageTag: e55fd03c-4585-4430-bf3d-229d5d83ee4b

	measure 'Stock Total' =
			
			SUM(medicamentos_multifuente[stock])
		formatString: 0
		lineageTag: 9a30cc9e-1519-4de6-b893-3321fc327b12

	measure 'Stock Promedio' =
			
			AVERAGE(medicamentos_multifuente[stock])
		lineageTag: 8dba33e8-11f8-40e0-97b6-b82d8e1fc9c3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Medicamentos Stock Bajo' =
			
			CALCULATE(
			    DISTINCTCOUNT(medicamentos_multifuente[id_medicamento]),
			    medicamentos_multifuente[stock] < 200
			)
		formatString: 0
		lineageTag: adca9d63-b71b-4cb3-bb2a-7a60a6901e6f

	measure 'Total Ensayos' =
			
			SUM(resumen_ensayos_medicamentos[total_ensayos])
		formatString: 0
		lineageTag: 20dbf4c8-e6ef-473f-b070-2e0cc6c6b694

	measure 'Total Reingresos' =
			
			DISTINCTCOUNT(
			    reingresos_30_dias[hospitalizacion_reingreso]
			)
		formatString: 0
		lineageTag: 58a99e3d-2119-40b5-96ef-4a0849b58e75

	measure 'Promedio de Días entre Reingresos' =
			
			AVERAGE(
			    reingresos_30_dias[dias_entre_ingresos]
			)
		lineageTag: a7f21186-6f00-4018-ab09-4c9d3868c0e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Pacientes con Reingreso' =
			
			DIVIDE(
			    DISTINCTCOUNT(reingresos_30_dias[id_paciente]),
			    CALCULATE(
			        DISTINCTCOUNT(reingresos_30_dias[id_paciente]),
			        REMOVEFILTERS(reingresos_30_dias)
			    ),
			    0
			)
		lineageTag: e1a47d5d-31de-4121-abb5-60c95499d8ca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Participación por Medicamento Recetado' =
			
			DIVIDE(
			    [Total Medicamentos Recetados],
			    CALCULATE(
			        [Total Medicamentos Recetados],
			        REMOVEFILTERS(dim_medicamento)
			    ),
			    0
			)
		lineageTag: bca4bd0d-7066-4af9-8e59-97fa4f1d2c16

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Total_Prescripciones =
			
			COUNTROWS(fact_prescripciones)
		formatString: 0
		lineageTag: 4a4d4d3a-2bc1-4d7e-9410-dda2897fd40a

	measure 'Medicamentos Distintos' =
			
			DISTINCTCOUNT(dim_medicamento[id_medicamento])
		formatString: 0
		lineageTag: 4d19c993-af2a-4ced-9ae6-51f4bff3427d

	measure 'Diagnósticos Únicos' =
			
			DISTINCTCOUNT(resumen_diagnosticos_icd11[codigo_icd11])
		formatString: 0
		lineageTag: 52a4f7c3-a0b1-43b2-8a0a-22b6e8874d36

	measure 'Total Diagnósticos' =
			
			COUNTROWS(resumen_diagnosticos_icd11)
		formatString: 0
		lineageTag: 557cf410-2602-4ca3-8388-ecc3fcce5c20

	measure 'Promedio PM2.5' =
			
			AVERAGE(calidad_aire[pm2_5])
		lineageTag: 641fcc20-3e73-4e60-acee-da12a09e4771

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Promedio AQI' =
			
			AVERAGE(calidad_aire[us_aqi])
		lineageTag: f2fed213-d042-4d06-97c6-30c953c9a0ad

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Registros Ambientales' =
			
			COUNTROWS(Calidad_Aire)
		formatString: 0
		lineageTag: f3a4450a-699b-4de8-a04a-0fc5d7fd5496

	measure 'Promedio PM10' =
			
			AVERAGE(Calidad_Aire[pm10])
		lineageTag: a022742a-c15b-4afa-9a9b-46527ce740e5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Column
		formatString: 0
		lineageTag: 98eb1f7d-24ff-4348-b4ca-851b4c5bc55a
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Column]

		annotation SummarizationSetBy = Automatic

	partition 'Medidas DAX' = calculated
		mode: import
		source = Row("Column", BLANK())

	annotation PBI_Id = 682138c3f65144d383deb188d8aceaca

	annotation 436ba87b-9c83-4389-a31b-ebd06a36be98 = {"Expression":""}

