table Dim_Fecha
	lineageTag: fcd2f6d2-2b4e-49d9-af99-efb9caee871a
	dataCategory: Time

	column Date
		isKey
		formatString: General Date
		lineageTag: 8d6e8100-baa5-4183-be89-ea7c6378cbe1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

		annotation SummarizationSetBy = Automatic

	column Año
		formatString: 0
		lineageTag: b3ae5e1b-e827-462d-b5df-5c093e68101d
		summarizeBy: sum
		isNameInferred
		sourceColumn: [Año]

		annotation SummarizationSetBy = Automatic

	column Mes
		lineageTag: 9ad05c77-7c36-4aa6-8000-bedd77cb51ab
		summarizeBy: none
		isNameInferred
		sourceColumn: [Mes]

		annotation SummarizationSetBy = Automatic

	column NumeroMes
		formatString: 0
		lineageTag: 053fbc82-5900-485e-b4c3-1ca97db8356c
		summarizeBy: sum
		isNameInferred
		sourceColumn: [NumeroMes]

		annotation SummarizationSetBy = Automatic

	column Trimestre
		lineageTag: 15e28acc-e27c-486e-aac2-75d54bc60ebd
		summarizeBy: none
		isNameInferred
		sourceColumn: [Trimestre]

		annotation SummarizationSetBy = Automatic

	column AñoMes
		lineageTag: 006c9116-99eb-46aa-bafe-28d8cefd4db6
		summarizeBy: none
		isNameInferred
		sourceColumn: [AñoMes]

		annotation SummarizationSetBy = Automatic

	partition Dim_Fecha = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(2025,1,1),
				        DATE(2027,12,31)
				    ),
				    "Año", YEAR([Date]),
				    "Mes", FORMAT([Date], "MMMM"),
				    "NumeroMes", MONTH([Date]),
				    "Trimestre", "T" & FORMAT([Date], "Q"),
				    "AñoMes", FORMAT([Date], "YYYY-MM")
				)

	annotation PBI_Id = 989697c0c8be4f29a78dc3d5bd015b89

